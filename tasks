#!/usr/bin/env python3
"""Track tasks (GitHub issues, Jira tickets, untitled work) through created → research → code → testing → pr → merged."""
import argparse, fcntl, json, os, re, select, shutil, subprocess, sys, termios, time, tty
from contextlib import contextmanager
from datetime import datetime, timezone

STATUSES = ["created", "research", "code", "testing", "pr", "merged"]
DONE = "\033[1;92m{}\033[0m"  # bold bright green for reached stages
STORE = os.path.expanduser(os.environ.get("TASKS_FILE", "~/.local/state/herdr-tasks/tasks.json"))
SELF = os.path.realpath(__file__)
try:  # personal settings in a gitignored .env next to the script; real environment variables win
    with open(os.path.join(os.path.dirname(SELF), ".env")) as f:
        for line in f:
            k, sep, v = line.strip().partition("=")
            if sep and not k.startswith("#"):
                os.environ.setdefault(k.strip(), v.strip())
except FileNotFoundError:
    pass
HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
DONE_SECTION, DONE_DAYS = "Done", 14  # merged tasks are listed here, newest first, for this many days
JQL = os.environ.get("TASKS_JIRA_JQL", "assignee = currentUser() AND statusCategory != Done AND issuetype != Epic")
START_DIR = os.environ.get("TASKS_START_DIR", "~")  # where `start --workspace` opens, and repos are looked for
SYNC_EVERY = 300  # seconds between Jira syncs while the board is open

INSTRUCTIONS = f"""This Claude session runs in a Herdr pane that is tracked on a task board. Keep the board current with:
  {SELF} set <stage> [ref] [--title T] [--pr URL] [--note N]
- ref: GitHub issue (42, owner/repo#42, issue URL) or Jira key (PROJ-123). Omit it to update this pane's task.
- As soon as you know the ticket for the work, run `set <stage> <ref>`; that links this pane's task to it. Work with no ticket: omit ref and give a short --title.
- Stages: research (investigating), code (changing code), testing (verifying), pr (once you open a PR; pass --pr <url>). Never set merged.
- Stages only move forward. Moving a task back needs --force: never pass it on your own; ask the user first and use it only if they say yes. If `set` refuses, leave the stage as it is.
- Pick the stage from the state of the work, not from how the user phrases the request: check the branch, `git status`/`git diff` and whether a PR exists (`gh pr view`). Uncommitted or branch changes for the task mean at least `code`; an open PR means `pr`.
- Look at the stage again once your first pass over the code is done, and run `set` whenever it changes. Skip all of this for quick questions that aren't work on a task."""


def sh(*cmd, check=True, cwd=None):
    r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL, cwd=cwd)
    if check and r.returncode:
        sys.exit(f"{' '.join(cmd[:3])}…: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def load():
    try:
        with open(STORE) as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    data.setdefault("tasks", {})
    data.setdefault("panes", {})
    for t in data["tasks"].values():
        for e in t["history"]:
            if e["status"] == "released":
                e["status"] = "merged"
    return data


@contextmanager
def store():
    os.makedirs(os.path.dirname(STORE), exist_ok=True)
    with open(STORE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load()
        yield data
        tmp = STORE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, STORE)


def resolve(ref, repo=None, cwd=None):
    """Turn a ref into a task key: owner/repo#42, PROJ-123 or task-7."""
    if re.fullmatch(r"task-\d+", ref):
        return ref
    m = re.fullmatch(r"(?:https?://\S+/browse/)?([A-Z][A-Z0-9]+-\d+)", ref)
    if m:
        return m[1]
    m = (re.fullmatch(r"https://github\.com/([\w.-]+/[\w.-]+)/issues/(\d+)", ref)
         or re.fullmatch(r"(?:([\w.-]+/[\w.-]+))?#?(\d+)", ref))
    if not m:
        sys.exit(f"bad ref {ref!r}: use 42, #42, owner/repo#42, an issue URL or a Jira key like PROJ-123")
    repo = m[1] or repo or sh("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner", cwd=cwd).strip()
    return f"{repo}#{m[2]}"


def fetch(key):
    if "#" in key:
        repo, num = key.split("#")
        info = json.loads(sh("gh", "issue", "view", num, "-R", repo, "--json", "title,url"))
        return dict(repo=repo, number=int(num), **info)
    raw = json.loads(sh("jira", "issue", "view", key, "--raw"))
    return dict(title=raw["fields"]["summary"], url=raw["self"].split("/rest/")[0] + "/browse/" + key)


def transition(data, key, status, pane=None, note=None):
    entry = {k: v for k, v in dict(status=status, at=now(), pane=pane, note=note).items() if v}
    data["tasks"][key]["history"].append(entry)
    if pane:
        sh(HERDR, "pane", "report-metadata", pane, "--source", "simpikkle.tasks",
           "--custom-status", " ".join(filter(None, [label(key, data["tasks"][key]), status])), check=False)


def ensure(data, key):
    if key not in data["tasks"]:
        if key.startswith("task-"):
            sys.exit(f"no task {key}")
        data["tasks"][key] = dict(fetch(key), history=[])
        transition(data, key, "created")
    return key


def new_local(data, title, pane=None, auto=False):
    n = 1 + max((int(k[5:]) for k in data["tasks"] if k.startswith("task-")), default=0)
    key = f"task-{n}"
    data["tasks"][key] = dict(title=title, history=[], **({"auto": True} if auto else {}))
    transition(data, key, "created", pane)
    return key


def bind(data, pane, key, session=None):
    """Link a pane to a task. A local task the pane was on is folded into the ticket it turned out to be."""
    old = data["panes"].get(pane, {})
    prev = old.get("task")
    if prev != key and prev in data["tasks"] and prev.startswith("task-") and not key.startswith("task-"):
        p, t = data["tasks"].pop(prev), data["tasks"][key]
        t["history"] = sorted(p["history"] + t["history"], key=lambda e: e["at"])
    data["panes"][pane] = dict(old, task=key, **({"session": session} if session else {}))


def apply(pane, status, ref=None, title=None, pr=None, note=None, repo=None, cwd=None, session=None, force=False):
    with store() as data:
        if ref:
            key = ensure(data, resolve(ref, repo, cwd))
            if pane:
                bind(data, pane, key, session)
        else:
            key = data["panes"].get(pane, {}).get("task") if pane else None
            if key not in data["tasks"]:
                if not title:
                    sys.exit("no task linked to this pane: pass a ref or --title")
                key = new_local(data, title)
                if pane:
                    bind(data, pane, key, session)
        t = data["tasks"][key]
        t.update({k: v for k, v in dict(title=title, pr=pr).items() if v})
        if title:
            t.pop("auto", None)
        was = t["history"][-1]["status"]
        if STATUSES.index(status) < STATUSES.index(was) and not force:
            sys.exit(f"{key} is at {was}; moving it back to {status} needs --force")
        transition(data, key, status, pane, note)
    return key


def cmd_set(a):
    pane = None if a.detached else os.environ.get("HERDR_PANE_ID")
    key = apply(pane, a.status, a.ref, a.title, a.pr, a.note, a.repo, force=a.force)
    print(f"{key} → {a.status}")


def cmd_add(a):
    with store() as data:
        key = ensure(data, resolve(a.ref, a.repo))
    print(key)


def cmd_rm(a):
    with store() as data:
        key = resolve(a.ref, a.repo)
        if not data["tasks"].pop(key, None):
            sys.exit(f"no task {key}")
        data["panes"] = {p: b for p, b in data["panes"].items() if b.get("task") != key}
    print(f"removed {key}")


def cmd_sync(a):
    sync_jira(a.jql)
    sync_prs()


FAILED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}


def sync_prs():
    """Refresh CI and review state of open PRs; move tasks whose PR was merged to merged."""
    checked = merged = 0
    for key, t in load()["tasks"].items():
        if not t.get("pr") or t["history"][-1]["status"] == "merged":
            continue
        r = subprocess.run(["gh", "pr", "view", t["pr"], "--json", "state,reviewDecision,statusCheckRollup"],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if r.returncode:
            continue
        pr, checked = json.loads(r.stdout), checked + 1
        checks = pr["statusCheckRollup"] or []
        results = {c.get("conclusion") or c.get("state") or "" for c in checks}
        ci = ("failing" if results & FAILED else
              "running" if any(c.get("status", "COMPLETED") != "COMPLETED" or c.get("state") in ("PENDING", "EXPECTED") for c in checks) else
              "passing" if checks else None)
        review = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes requested", "REVIEW_REQUIRED": "review required"}.get(pr["reviewDecision"])
        with store() as data:
            if key not in data["tasks"]:
                continue
            t = data["tasks"][key]
            t["pr_status"] = {k: v for k, v in dict(state=pr["state"].lower(), ci=ci, review=review).items() if v}
            if pr["state"] == "MERGED":
                transition(data, key, "merged")
                merged += 1
    print(f"{checked} PRs checked, {merged} merged")


def sync_jira(jql):
    """Add Jira issues matching JQL that aren't tracked yet and refresh titles."""
    try:
        r = subprocess.run(["jira", "issue", "list", "-q", jql, "--raw"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        return print("jira CLI not found, skipping Jira")
    try:
        issues = json.loads(r.stdout)
    except ValueError:
        if "No result found" not in r.stdout + r.stderr:
            return print(f"jira issue list: {r.stderr.strip() or r.stdout.strip()}", file=sys.stderr)
        issues = []
    view = lambda key: json.loads(sh("jira", "issue", "view", key, "--raw"))
    data = load()
    base = None
    for i in issues:
        if i["key"] not in data["tasks"] and not base:
            base = view(i["key"])["self"].split("/rest/")[0]
    added = []
    with store() as data:
        for i in issues:
            key, summary = i["key"], i["fields"]["summary"]
            if key not in data["tasks"]:
                data["tasks"][key] = dict(title=summary, url=f"{base}/browse/{key}", history=[])
                transition(data, key, "created")
                added.append(key)
            data["tasks"][key]["title"] = summary
    print(f"{len(issues)} issues, added {len(added)}" + (f": {' '.join(added)}" if added else ""))


def cmd_rename(a):
    with store() as data:
        key = resolve(a.ref, a.repo)
        if key not in data["tasks"]:
            sys.exit(f"no task {key}")
        data["tasks"][key]["title"] = a.title
        data["tasks"][key].pop("auto", None)
    print(f"{key}: {a.title}")


def cmd_list(a):
    tasks = load()["tasks"]
    if a.json:
        return print(json.dumps(tasks, indent=2))
    for key, t in tasks.items():
        print("\t".join([key, t["history"][-1]["status"], t.get("pr", ""), t["title"]]))


def find(obj, field):
    """First value of `field` anywhere in a nested JSON response."""
    if isinstance(obj, dict):
        if field in obj:
            return obj[field]
        obj = list(obj.values())
    for v in obj if isinstance(obj, list) else []:
        r = find(v, field)
        if r is not None:
            return r


def cmd_start(a):
    with store() as data:
        key = ensure(data, resolve(a.ref, a.repo))
        task = data["tasks"][key]
    name = "t-" + re.sub(r"[^a-z0-9_-]", "-", (label(key, task) or key).lower())[:30]  # Herdr: lowercase, starts with a letter, ≤32
    if a.workspace:  # a new workspace named after the ticket, with a "research" tab
        cwd = os.path.expanduser(START_DIR)
        ws = find(json.loads(sh(HERDR, "workspace", "create", "--cwd", cwd, "--label", label(key, task) or key, "--focus")), "workspace_id")
        pane = json.loads(sh(HERDR, "pane", "list", "--workspace", ws))["result"]["panes"][0]
        sh(HERDR, "tab", "rename", pane["tab_id"], "research", check=False)
        pane = pane["pane_id"]
        read = f"`gh issue view {task['number']} -R {task['repo']}`" if task.get("number") else f"`jira issue view {key}`"
        prompt = (f"Read {task['url']} ({task['title'].strip()}) with {read}. Find the repository it belongs to under {cwd} "
                  f"(ask me if it isn't clear), then investigate and figure out how to fix it. Propose the fix before changing code.")
    else:
        cwd = os.getcwd()
        pane = json.loads(sh(HERDR, "pane", "split", "--current", "--direction", a.direction,
                             "--cwd", cwd, "--no-focus"))["result"]["pane"]["pane_id"]
        prompt = f"Work on {task['url']} ({task['title'].strip()})."
    with store() as data:
        bind(data, pane, key)
        if STATUSES.index(data["tasks"][key]["history"][-1]["status"]) < STATUSES.index("research"):
            transition(data, key, "research", pane)
    sh(HERDR, "agent", "start", name, "--kind", a.kind, "--pane", pane)
    sh(HERDR, "agent", "prompt", name, prompt + (
        f" Report your phase whenever it changes by running `{SELF} set <stage> {key}`: `research` while investigating, "
        f"`code` once you change code, `testing` while verifying, `pr` once you open a PR (add `--pr <url>`). Never set `merged`."))
    print(f"{key}: agent {name} started in {pane}")


def cmd_enroll(a):
    """Interactive: link a pane (default: the one the action was invoked on) to a task."""
    pane = a.pane or os.environ.get("TASKS_PANE") or os.environ.get("HERDR_PANE_ID")
    if not pane:
        sys.exit("no pane to enroll")
    info = json.loads(sh(HERDR, "pane", "get", pane))["result"]["pane"]
    session = (info.get("agent_session") or {}).get("value")
    with store() as data:
        cur = data["tasks"].get(data["panes"].get(pane, {}).get("task"))
    print(f"Enroll pane {pane} ({info.get('terminal_title_stripped') or info.get('cwd')})")
    if cur:
        print(f"currently: {cur['title']}")
    try:
        ref = input("Ticket (42, owner/repo#42, PROJ-123, URL; blank for none): ").strip()
        title = None if ref else input("Title: ").strip()
        stage = cur["history"][-1]["status"] if cur else "research"
        key = apply(pane, stage, ref, title, cwd=info.get("cwd"), session=session)
    except (EOFError, KeyboardInterrupt):
        return
    except SystemExit as e:
        print(e)
        input("Enter to close")
        return
    print(f"enrolled {key}")


def cmd_hook(a):
    """Claude Code hooks: `session` prints board instructions, `prompt` gives every untracked session a task."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return
    try:
        inp = json.load(sys.stdin)
    except ValueError:
        inp = {}
    if a.event == "session":
        tickets = [f"{label(k, t)} {t['title'].strip()}"
                   for k, t in load()["tasks"].items() if label(k, t) and t["history"][-1]["status"] != "merged"]
        return print(INSTRUCTIONS + ("\n- Open tickets on the board. If this work belongs to one, link to it with `set <stage> <ref>`; several tabs can share "
                        "a ticket and its stage:\n" + "\n".join(f"  {x}" for x in tickets) if tickets else ""))
    sid, prompt = inp.get("session_id"), " ".join(inp.get("prompt", "").split())
    if not prompt or re.fullmatch(r"/\S+", prompt):
        return
    with store() as data:
        b = data["panes"].get(pane)
        if b and b.get("task") in data["tasks"] and b.get("session") in (None, sid):
            b["session"] = sid
        else:
            data["panes"][pane] = dict(task=new_local(data, prompt[:60], pane, auto=True), session=sid)


def label(key, t):
    """The ticket ID as shown to people; None for tasks without a ticket."""
    if t.get("number"):
        return f"{t['repo'].split('/')[-1]}#{t['number']}"
    return None if key.startswith("task-") else key


def ago(iso):
    """Elapsed time like 13m or 2h; a local date like "Oct 7 (Wed)" once it's 8h or more."""
    at = datetime.fromisoformat(iso)
    s = int((datetime.now(timezone.utc) - at).total_seconds())
    if s >= 8 * 3600:
        local = at.astimezone()
        return f"{local:%b} {local.day} ({local:%a})"
    return next(f"{s // d}{u}" for d, u in ((3600, "h"), (60, "m"), (1, "s")) if s >= d or u == "s")


def live_panes():
    try:
        return {p["pane_id"]: p for p in json.loads(sh(HERDR, "pane", "list", check=False))["result"]["panes"]}
    except Exception:
        return {}


GAP = 10  # distance between stage columns
START = "▶ start"
DIM, BOLD = "\033[2m{}\033[0m", "\033[1;4m{}\033[0m"
PR_STYLES = {"CI failing": "\033[1;91m{}\033[0m", "changes requested": "\033[1;91m{}\033[0m", "PR closed": "\033[1;91m{}\033[0m",
             "approved": "\033[92m{}\033[0m", "CI passing": "\033[92m{}\033[0m", "CI running": "\033[93m{}\033[0m"}
AGENT_ICONS = {"working": "◐", "blocked": "◉", "done": "✓", "idle": "○"}  # single-width, so line widths stay exact
PR_STYLES.update({"◐": "\033[1;93m{}\033[0m", "◉": "\033[1;91m{}\033[0m", "✓": "\033[1;92m{}\033[0m", "○": "\033[2m{}\033[0m"})


def last_pane(t):
    return next((e["pane"] for e in reversed(t["history"]) if e.get("pane")), None)


def prune(live):
    """Drop tasks without a ticket whose pane has closed."""
    data = load()
    dead = [k for k, t in data["tasks"].items() if not label(k, t) and last_pane(t) and last_pane(t) not in live
            and t["history"][-1]["status"] != "merged"]
    if live and dead:
        with store() as data:
            for k in dead:
                data["tasks"].pop(k, None)
            data["panes"] = {p: b for p, b in data["panes"].items() if b.get("task") in data["tasks"]}


def render(selected=None):
    """Board lines, plus {line index: (selection id, live pane, PR url, PR column span)} for task and tab rows."""
    live = live_panes()
    prune(live)
    data = load()
    tasks = data["tasks"]
    try:  # ask the tty: a stale COLUMNS env from pane spawn would win in shutil
        cols = os.get_terminal_size(sys.stdout.fileno()).columns
    except OSError:
        cols = shutil.get_terminal_size().columns
    x0 = max([len(label(k, t) or "") + 8 for k, t in tasks.items()] + [14])

    def rail(name="", mark=False):
        """A spacer line: optional heading or selection mark, then a dotted rail under every stage."""
        rest = (" " * x0 + ("┆" + " " * (GAP - 1)) * len(STATUSES)).rstrip()
        if mark:
            return "\033[1m› \033[0m" + DIM.format(rest[2:])
        return (BOLD.format(name) + " " if name else "") + DIM.format(rest[len(name) + 1 if name else 0:])  # long names cover the rail

    def session_title(pane):
        term = pane.get("terminal_title_stripped")
        return term if term and term != "Claude Code" else None

    header = [" "] * (x0 + GAP * len(STATUSES))
    for i, s in enumerate(STATUSES):
        x = x0 + i * GAP - len(s) // 2
        header[x:x + len(s)] = s
    out, rows = ["".join(header).rstrip()], {}
    sections = {}  # active tasks: furthest stage first, then most recent; Done: newest first
    for key, t in sorted(tasks.items(), key=lambda kt: (STATUSES.index(kt[1]["history"][-1]["status"]), kt[1]["history"][-1]["at"]), reverse=True):
        cur = t["history"][-1]
        if cur["status"] != "merged":
            sections.setdefault("", []).append((key, t))
        elif (datetime.now(timezone.utc) - datetime.fromisoformat(cur["at"])).days < DONE_DAYS:
            sections.setdefault(DONE_SECTION, []).append((key, t))
    for section in sorted(sections, key=lambda p: p == DONE_SECTION):
        done = section == DONE_SECTION  # a plain list under a divider: no stage rails, no tab lines
        out += ["", DONE.format(f"✓ {DONE_SECTION} ") + DIM.format("─" * max(0, cols - len(DONE_SECTION) - 4)), ""] if done else []
        for key, t in sections[section]:
            cur = t["history"][-1]
            mark = "\033[1m› \033[0m" if key == selected else "  "
            n, row = STATUSES.index(cur["status"]), mark + f"  {label(key, t) or ''}".ljust(x0 - 2)
            for i, s in enumerate(STATUSES if not done else []):
                if i:
                    row += DONE.format("━" * (GAP - 1)) if i <= n else DIM.format("─" * (GAP - 1))
                row += DONE.format("●") if i <= n else DIM.format("○")
            tabs = [p for p, b in data["panes"].items() if b.get("task") == key and p in live]  # tabs on this ticket
            if last_pane(t) in live and last_pane(t) not in tabs:
                tabs.append(last_pane(t))
            pane = live.get(last_pane(t)) or (live[tabs[0]] if tabs else {})
            agent = pane.get("agent_status") if not label(key, t) else None  # tickets list their tabs below instead
            title = (t.get("auto") and session_title(pane)) or t["title"]
            m = re.search(r"/pull/(\d+)", t.get("pr", ""))
            pr = (f"PR #{m[1]}" if m else "PR") if t.get("pr") else None
            x, room, info, span, start_span = x0 if done else x0 + GAP * (len(STATUSES) - 1) + 1, cols - 1, "", None, None
            ps = t.get("pr_status", {}) if pr and cur["status"] != "merged" else {}
            prs = [p for p in [ps.get("review"), ps.get("ci") and f"CI {ps['ci']}", ps.get("state") == "closed" and "PR closed"] if p]
            start = START if label(key, t) and cur["status"] == "created" and not pane else None
            rest = [p for p in [ago(cur['at']), pr, *prs, cur.get("note"),
                                AGENT_ICONS.get(agent) if pane else start or "no tab"] if p]
            fit = room - x - 2 - sum(len(p) + 3 for p in rest)  # shorten the title so the PR link and status stay visible
            title = title.strip() if len(title.strip()) <= fit else title.strip()[:max(fit - 1, 10)] + "…"
            for piece in [title] + rest:
                text = (" · " if info else "  ") + piece
                fits = text[:max(0, room - x)]
                style = PR_STYLES.get(piece)
                if piece is start and len(fits) == len(text):
                    start_span = (x + len(text) - len(start), x + len(text))
                    info += DIM.format(text[:-len(start)]) + f"\033[1;92m{start}\033[0m"
                elif piece is pr and len(fits) == len(text):
                    span = (x + len(text) - len(pr), x + len(text))
                    info += DIM.format(text[:-len(pr)]) + f"\033[36;4m{pr}\033[0m"
                elif style and len(fits) == len(text):
                    info += DIM.format(text[:-len(piece)]) + style.format(piece)
                else:
                    info += DIM.format(fits)
                x += len(fits)
            ticket = (t.get("url"), (4, 4 + len(label(key, t)))) if label(key, t) and t.get("url") else (None, None)
            if not done:
                out.append(rail())
            rows[len(out)] = (key, pane, t.get("pr"), span, *ticket, start_span)
            out.append(row + info)
            if label(key, t) and not done:
                for p in tabs:
                    sel, tab = f"{key} {p}", live[p]
                    icon = AGENT_ICONS.get(tab.get("agent_status"), " ")
                    text = (session_title(tab) or "untitled tab")[:max(0, cols - x0 - GAP * (len(STATUSES) - 1) - 7)]
                    rows[len(out)] = (sel, tab, None, None, None, None, None)
                    out.append(rail(mark=sel == selected) + DIM.format("  ↳ ") + PR_STYLES.get(icon, "{}").format(icon) + DIM.format(" " + text))
    return out + ([] if DONE_SECTION in sections else [rail()]), rows


def jump(pane, later=False):
    """Focus a pane's workspace and tab. `later` runs it detached, after a popup board has closed."""
    if not pane:
        return False
    cmds = [[HERDR, "workspace", "focus", pane["workspace_id"]], [HERDR, "tab", "focus", pane["tab_id"]]]
    if later:
        script = "sleep 0.2; " + "; ".join(" ".join(f"'{c}'" for c in cmd) for cmd in cmds)
        subprocess.Popen(["sh", "-c", script], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        for cmd in cmds:
            sh(*cmd, check=False)
    return True


def cmd_board(a):
    if a.once or not sys.stdin.isatty():
        return print("\n".join(render()[0]))
    fd, old = sys.stdin.fileno(), termios.tcgetattr(sys.stdin)
    tty.setcbreak(fd)
    sys.stdout.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")  # alt screen, no cursor, SGR mouse clicks
    selected, syncing, synced, offset = None, None, 0, 0
    HEAD = 1  # stage names stay pinned while the rest scrolls
    try:
        while True:
            if (syncing is None or syncing.poll() is not None) and time.time() - synced > SYNC_EVERY:
                syncing, synced = subprocess.Popen([sys.executable, SELF, "sync"], stdin=subprocess.DEVNULL,
                                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), time.time()
            lines, rows = render(selected)
            keys = [r[0] for r in rows.values()]
            room = max(1, os.get_terminal_size(fd).lines - HEAD - 2)
            sel_line = next((i for i, r in rows.items() if r[0] == selected), None)
            if sel_line is not None:  # keep the selection on screen
                offset = min(max(offset, sel_line - HEAD - room + 1), sel_line - HEAD)
            offset = max(0, min(offset, len(lines) - HEAD - room))
            body = lines[HEAD + offset:HEAD + offset + room]
            sys.stdout.write("\033[H\033[2J" + "\n".join(lines[:HEAD] + body + [""] * (room - len(body) + 1))
                             + "\n\033[90m◐ working ◉ needs you ✓ done ○ idle   ↑↓/jk select · enter or click jump · click ID/PR open · s sync Jira · "
                             + ("q/esc close" if a.popup else "q quit") + "\033[0m")
            sys.stdout.flush()
            if not select.select([sys.stdin], [], [], 2)[0]:
                continue
            buf = os.read(fd, 256).decode(errors="ignore")
            by_key = {r[0]: r for r in rows.values()}
            for click in re.finditer(r"\033\[<(\d+);(\d+);(\d+)M", buf):  # button;col;row, 1-based
                b, col, line = int(click[1]), int(click[2]) - 1, int(click[3]) - 1
                line += offset if line >= HEAD else 0
                if b in (64, 65):  # wheel
                    offset += 3 if b == 65 else -3
                    selected = None
                elif b == 0 and line in rows:
                    key, pane, pr, span, url, url_span, start_span = rows[line]
                    selected = key
                    if start_span and start_span[0] <= col < start_span[1]:
                        with open(STORE + ".start.log", "a") as log:  # errors from the background start land here
                            subprocess.Popen([sys.executable, SELF, "start", key, "--workspace"], start_new_session=True,
                                             stdin=subprocess.DEVNULL, stdout=log, stderr=log)
                        if a.popup:
                            return
                    elif span and span[0] <= col < span[1]:
                        sh("open", pr, check=False)
                    elif url_span and url_span[0] <= col < url_span[1]:
                        sh("open", url, check=False)
                    elif jump(pane, a.popup) and a.popup:
                        return
            buf = re.sub(r"\033\[<[\d;]*[Mm]", "", buf)
            if "q" in buf or (a.popup and buf == "\033"):
                break
            if "s" in buf:
                synced = 0
            for k in re.findall(r"\033\[[AB]|[jk\r\no]", buf):
                i = keys.index(selected) if selected in keys else -1
                if k in ("\033[B", "j") and keys:
                    selected = keys[min(i + 1, len(keys) - 1)]
                elif k in ("\033[A", "k") and keys:
                    selected = keys[max(i - 1, 0)]
                elif k in "\r\n" and selected in by_key:
                    if jump(by_key[selected][1], a.popup) and a.popup:
                        return
                elif k == "o" and selected in by_key and by_key[selected][2]:
                    sh("open", by_key[selected][2], check=False)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")


